# Providers
CHAT_PROVIDER=gemini
EMBED_PROVIDER=voyage

# Models (verify current names in each provider's docs)
CHAT_MODEL=gemini-3.8-flash
EMBED_MODEL=voyage-4-lite
EMBED_DIMENSION=1024

# Keys (never commit the real .env)
GEMINI_API_KEY=
VOYAGE_API_KEY=

# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/notebooklm